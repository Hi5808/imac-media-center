<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="plugin.video.arrsearch" name="Find Media" version="1.1.1" provider-name="local">
  <requires>
    <import addon="xbmc.python" version="3.0.0"/>
  </requires>
  <extension point="xbmc.python.pluginsource" library="default.py">
    <provides>video</provides>
  </extension>
  <extension point="xbmc.addon.metadata">
    <summary lang="en_GB">Search and add TV shows and movies</summary>
    <description lang="en_GB">Search for TV shows and movies from the couch, add them to Sonarr/Radarr, and watch the download queue - without leaving Kodi.</description>
    <platform>all</platform>
    <license>MIT</license>
  </extension>
</addon>
